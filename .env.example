# SuperTaco Environment Variables
# Copy this file to .env and fill in your actual values

# Nebius AI Cloud / Token Factory
NEBIUS_API_KEY=your_nebius_token_factory_key_here
NEBIUS_PROJECT_ID=SuperTaco

# Tavily API Key (for error context lookup)
TAVILY_API_KEY=your_tavily_api_key_here

# Token Factory Base URL (OpenAI-compatible)
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Environment: dev or prod (prod blocks dry-run-only bypasses)
SANDBOXTUNE_ENV=dev